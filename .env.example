# ═══════════════════════════════════════════════════════════════
# EMAIL DELIVERY
#
# WORKS OUT OF THE BOX — no variables required.
# The site falls back to FormSubmit, a relay that needs no API key.
# The first enquiry emails wordbitx@gmail.com an "Activate Form" link.
# Click it ONCE and all future enquiries arrive automatically.
#
# The options below are OPTIONAL upgrades that skip the activation
# step and deliver directly. Add them on your host
# (Vercel → Settings → Environment Variables), then REDEPLOY.
#
# Check status any time at:  https://your-site.com/api/health
# ═══════════════════════════════════════════════════════════════

# ── OPTION A — GMAIL (easiest, recommended) ────────────────────
# 1. Go to https://myaccount.google.com/security
# 2. Turn ON "2-Step Verification"  (required — App Passwords need it)
# 3. Open https://myaccount.google.com/apppasswords
# 4. Create an app password named "WordbitX Website"
# 5. Copy the 16-character code and paste it below (spaces are fine)
# GMAIL_USER=wordbitx@gmail.com
# GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# ── OPTION B — RESEND (best deliverability, no Gmail limits) ───
# Sign up at resend.com → verify wordbitxtech.com → create an API key
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# MAIL_FROM="WordbitX Website <onboarding@resend.dev>"

# ── OPTION C — CUSTOM SMTP (cPanel mailbox) ────────────────────
# SMTP_HOST=mail.wordbitxtech.com
# SMTP_PORT=465
# SMTP_USER=info@wordbitxtech.com
# SMTP_PASS=your-mailbox-password

# Where enquiries are delivered. Defaults to wordbitx@gmail.com
# MAIL_TO=wordbitx@gmail.com


# ═══════════════════════════════════════════════════════════════
# DATABASE (OPTIONAL)
# Only keeps an extra stored copy of enquiries. The contact form
# works on email alone, so this can be left unset on Vercel.
# ═══════════════════════════════════════════════════════════════
# DATABASE_URL=postgresql://user:password@host:5432/dbname


# ═══════════════════════════════════════════════════════════════
# REVIEW ADMIN (delete visitor reviews)
# Open /admin/reviews and enter this password.
# Locally it defaults to: wordbitx
# On the live site you MUST set this, then redeploy.
# ═══════════════════════════════════════════════════════════════
# REVIEW_ADMIN_SECRET=choose-a-strong-password


# ═══════════════════════════════════════════════════════════════
# ANALYTICS / SEARCH CONSOLE (OPTIONAL)
# No tracking scripts ship until these are set.
# ═══════════════════════════════════════════════════════════════
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_FACEBOOK_PIXEL_ID=123456789012345
# GOOGLE_SITE_VERIFICATION=your-verification-token

# ═══════════════════════════════════════════════════════════════
# GOOGLE ADSENSE
# Copy Publisher ID from AdSense → Account → Account information
# (pub-xxxxxxxxxxxxxxxx). Then redeploy. ads.txt is served at /ads.txt.
# ═══════════════════════════════════════════════════════════════
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# ADSENSE_PUBLISHER_ID=pub-xxxxxxxxxxxxxxxx
